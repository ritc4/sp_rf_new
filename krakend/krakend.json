{
  "$schema": "https://krakend.io",
  "version": 3,
  "port": 8080,
  "timeout": "3s",
  "cache_ttl": "0s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["POST", "GET", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Cookie", "Accept"],
      "expose_headers": ["Content-Length", "Set-Cookie"],
      "allow_credentials": true,
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/auth/register",
      "method": "POST",
      "output_encoding": "json",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 10.0,
          "capacity": 10.0
        }
      },
      "backend": [
        {
          "url_pattern": "/auth/register",
          "method": "POST",
          "host": ["http://core-go:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Content-Type", "Cookie", "Accept"],
      "backend": [
        {
          "url_pattern": "/auth/login",
          "method": "POST",
          "host": ["http://core-go:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/refresh",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Cookie", "Content-Type", "Authorization"],
      "backend": [
        {
          "url_pattern": "/auth/refresh",
          "method": "POST",
          "host": ["http://core-go:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/logout",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Cookie", "Content-Type", "Authorization"],
      "backend": [
        {
          "url_pattern": "/auth/logout",
          "method": "POST",
          "host": ["http://core-go:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/catalog/product/{id}",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type", "Cookie"],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 5.0,          
          "capacity": 5.0,          
          "client_max_rate": 5.0,   
          "strategy": "ip"        
        }
      },
      "backend": [
        {
          "url_pattern": "/catalog/product/{id}",
          "method": "GET",
          "host": ["http://core-go:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/catalog/product",
      "method": "POST",
      "output_encoding": "json",
      "input_headers": ["Authorization", "Content-Type", "Cookie"],
      "backend": [
        {
          "url_pattern": "/catalog/product",
          "method": "POST",
          "host": ["http://core-go:8081"]
        }
      ]
    }
  ]
}
