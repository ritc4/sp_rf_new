{
  "name": "my-qwik-empty-starter",
  "description": "Blank project with routing included",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "echo 'Skipping...'",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode spa --host 0.0.0.0",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode spa --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite --mode spa --host 0.0.0.0",
    "qwik": "qwik"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.5",
    "@connectrpc/connect": "^2.0.2",
    "@connectrpc/connect-web": "^2.0.2",
    "centrifuge": "^5.2.2"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.3",
    "@builder.io/qwik-city": "^1.20.3",
    "@eslint/js": "^9",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.20.3",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "6.21.1",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
